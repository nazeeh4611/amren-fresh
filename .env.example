# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/amren-fresh

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Image storage (Cloudinary recommended - see src/services/imageStorage.ts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications (Expo push service, for the mobile app)
EXPO_ACCESS_TOKEN=

# Browser push notifications for the admin dashboard (Web Push / VAPID).
# Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must match the admin app's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@amrenfresh.ae

# Public API base URL (used in generated PDF links, CORS, etc.)
API_URL=http://localhost:4000
CORS_ORIGIN=*
